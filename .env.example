# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ADMIN_EMAIL: Target email for contact & unit registration notifications.
ADMIN_EMAIL="harmoniagroups@harmoniasyariah.com"

# Optional SMTP settings for direct email dispatch via Nodemailer
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""

# Google Maps Platform API key for the interactive office & site map
VITE_GOOGLE_MAPS_API_KEY=""
